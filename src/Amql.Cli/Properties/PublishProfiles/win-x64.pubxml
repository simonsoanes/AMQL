<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile: a single-file, self-contained amql-cli.exe for Windows.

  Usage: dotnet publish src/Amql.Cli -c Release -p:PublishProfile=win-x64
  Output: src/Amql.Cli/bin/Release/net10.0/win-x64/publish/amql-cli.exe

  Self-contained bundles the .NET 10 runtime, so the EXE runs on machines
  without the runtime installed. Trimming is intentionally OFF: the
  reflection-based JSON machinery and mmap path are not trim-safe in this
  build, so the trade for portability is size (~150 MB), not correctness.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>