<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Amql.Vindex3\Amql.Vindex3.csproj" />
    <ProjectReference Include="..\Amql.Safetensors\Amql.Safetensors.csproj" />
    <ProjectReference Include="..\Amql.Entail\Amql.Entail.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- GpuEngine.HostLogits: a span over the pinned buffer the device writes logits into. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The locally built CUDA backend (native/amql_cuda, gitignored) beside the
       binaries, so a rebuilt engine is the one that runs. Absent on CPU-only
       machines, where the managed path serves everything. -->
  <ItemGroup Condition="Exists('..\..\native\amql_cuda\bin\amql_cuda.dll') and ('$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win')))">
    <None Include="..\..\native\amql_cuda\bin\amql_cuda.dll" Link="amql_cuda.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <!-- The Linux builds of the same libraries (build-cuda.sh: the DGX Spark, say). -->
  <ItemGroup Condition="Exists('..\..\native\amql_cuda\bin\libamql_cuda.so') and !$(RuntimeIdentifier.StartsWith('win'))">
    <None Include="..\..\native\amql_cuda\bin\libamql_cuda.so" Link="libamql_cuda.so"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
