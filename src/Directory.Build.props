<Project>

  <!--
    Every project under src/ writes into one shared bin/<Configuration>/ folder
    at the repository root, so amql-cli.exe and amql-gui.exe sit side by side.
    That is not just tidiness: CliAutoDetect looks for the CLI adjacent to the
    GUI first, so a shared folder means the GUI finds the right CLI with no
    configuration and no stale hardcoded path.

    Scoped to src/ by living here rather than at the repository root. MSBuild
    stops at the nearest Directory.Build.props, so tests/Amql.Tests keeps its
    own output folder and does not spill xunit and its runner into the folder
    people actually launch things from.

    AppendTargetFrameworkToOutputPath is off because the two target frameworks
    in play — net11.0 for the libraries and CLI, net11.0-windows for the GUI —
    would otherwise land in separate subfolders and defeat the point. Mixing
    them in one directory is safe: each entry point carries its own
    runtimeconfig.json and deps.json, and the GUI's net11.0 dependencies belong
    beside it anyway.
  -->
  <PropertyGroup>
    <OutputPath>$(MSBuildThisFileDirectory)..\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!--
    A build for another operating system (dotnet publish -r linux-arm64 from
    Windows, for the DGX Spark) gets a folder of its own: amql-gui.dll there is
    the text-UI build, and it must not overwrite the WPF one beside the
    Windows executables.
  -->
  <!-- Appending the runtime also gives obj/ a folder per runtime: with one
       shared intermediate folder, a linux-x64 build after a linux-arm64 one
       reuses the arm64 launcher (amql-cli, amql-server) as up to date. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and !$(RuntimeIdentifier.StartsWith('win'))">
    <AppendRuntimeIdentifierToOutputPath>true</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

</Project>
