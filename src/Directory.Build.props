<Project>

  <!--
    Every runnable build of the projects under src/ lands in one folder per
    runtime and configuration at the repository root:

      bin/win-x64/Release      dotnet build -c Release (on Windows)
      bin/win-x64/Debug        dotnet build
      bin/linux-arm64/Release  scripts/publish-linux.sh (the DGX Spark)
      bin/linux-x64/Release    RID=linux-x64 scripts/publish-linux.sh

    One folder, not one per project: amql-cli, amql-server and amql-gui sit side
    by side, and the GUI finds the CLI and server beside itself first
    (ToolLocator), with no configuration and no stale hardcoded path.

    Scoped to src/ by living here rather than at the repository root. MSBuild
    stops at the nearest Directory.Build.props, so tests/Amql.Tests keeps its
    own output folder and does not spill xunit and its runner into the folder
    people launch things from.

    AppendTargetFrameworkToOutputPath is off because the two target frameworks
    in play — net11.0 for the libraries and CLI, net11.0-windows for the GUI —
    would otherwise land in separate subfolders and defeat the point. Mixing
    them in one directory is safe: each entry point carries its own
    runtimeconfig.json and deps.json, and the GUI's net11.0 dependencies belong
    beside it anyway.
  -->
  <PropertyGroup>
    <AmqlRuntime>$(RuntimeIdentifier)</AmqlRuntime>
    <AmqlRuntime Condition="'$(AmqlRuntime)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</AmqlRuntime>
    <AmqlBin>$(MSBuildThisFileDirectory)..\bin\$(AmqlRuntime)\$(Configuration)\</AmqlBin>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- An ordinary build (no runtime named): framework-dependent, straight into its folder. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <OutputPath>$(AmqlBin)</OutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!--
    A build for a named runtime is a publish (scripts/publish-linux.*,
    scripts/release/package.ps1, publish-exe.cmd). Its build output is an
    intermediate and stays under obj/, with a folder per runtime (appending the
    runtime also gives obj/ a folder per runtime: with one shared intermediate
    folder, a linux-x64 build after a linux-arm64 one reuses the arm64 launcher
    as up to date). Only the published files reach bin/<runtime>/<configuration>.

    Never into an ordinary build's folder: a self-contained publish puts its own
    hostfxr.dll and runtime beside the framework-dependent executables there,
    and their launchers then stop with "You must install or update .NET".
    publish-exe.cmd's single-file CLI therefore goes to dist/.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <OutputPath>$(MSBuildThisFileDirectory)..\obj\publish-build\$(Configuration)\</OutputPath>
    <AppendRuntimeIdentifierToOutputPath>true</AppendRuntimeIdentifierToOutputPath>
    <PublishDir Condition="'$(PublishDir)' == '' or '$(PublishDir)' == '$(OutputPath)publish\'">$(AmqlBin)</PublishDir>
  </PropertyGroup>

</Project>
