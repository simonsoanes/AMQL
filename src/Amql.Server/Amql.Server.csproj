<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Amql.Cli\Amql.Cli.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>amql-server</AssemblyName>
    <RootNamespace>Amql.Server</RootNamespace>
    <Description>HTTP server for AMQL containers: TypeSafe /v1/decisions (Von) and OpenAI-compatible embeddings, chat completions and responses, each offered only for containers that can serve it.</Description>
  </PropertyGroup>

</Project>
