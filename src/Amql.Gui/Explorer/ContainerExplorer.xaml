<UserControl x:Class="Amql.Gui.Explorer.ContainerExplorer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Amql.Gui.Explorer"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="300">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="6" Background="#FFF0F2F5" BorderBrush="#FFD0D7E2" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="OpenButton" Content="📂 Open Container…" Click="OnOpenContainer"
                            Padding="8,4" FontWeight="Bold"/>
                    <Button x:Name="CloseButton" Content="✕" Click="OnCloseContainer"
                            Padding="6,4" ToolTip="Close container"/>
                </StackPanel>
                <TextBlock x:Name="PathText" Text="No container loaded" FontSize="10"
                           TextTrimming="CharacterEllipsis" Foreground="Gray" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tree -->
        <TreeView x:Name="ModelTree" ItemsSource="{Binding Roots}"
                  SelectedItemChanged="OnNodeSelected"
                  VirtualizingStackPanel.IsVirtualizing="True">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="FontSize" Value="12"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type local:ExplorerNode}"
                                          ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Tooltip}">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                   MaxWidth="260"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
        </TreeView>
    </DockPanel>
</UserControl>