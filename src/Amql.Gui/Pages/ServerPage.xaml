<UserControl x:Class="Amql.Gui.Pages.ServerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,24" MaxWidth="1040" HorizontalAlignment="Stretch">
            <!-- Header -->
            <DockPanel Margin="0,0,0,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Click="OnOpenMonitor" Margin="0,0,8,0" Padding="14,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Margin="0,0,8,0"/>
                            <TextBlock Text="Monitor"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StartStopButton" Click="OnStartStop" Style="{DynamicResource AccentButtonStyle}" Padding="20,7" MinWidth="130">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StartStopIcon" Style="{StaticResource Icon}" Text="&#xE768;" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StartStopText" Text="Start server"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Inference server" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Pick the models to serve, set how much memory they may use, and start. Chat, embedding, classifier and decision models can all be loaded at once, each under its own name, behind one OpenAI-compatible endpoint."/>
                </StackPanel>
            </DockPanel>

            <!-- Status -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Ellipse x:Name="StatusDot" Width="12" Height="12" Margin="0,0,10,0" Fill="{StaticResource IdleBrush}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" x:Name="EndpointPanel" Visibility="Collapsed">
                            <TextBox x:Name="EndpointText" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" MinWidth="240"/>
                            <Button Click="OnCopyEndpoint" Margin="6,0,0,0" ToolTip="Copy the endpoint URL">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;"/>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Text="Not running" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <ProgressBar x:Name="LoadProgress" Height="4" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="RestartHint" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="Collapsed"
                               Text="You changed the setup while the server runs. The changes take effect when it restarts."/>
                    <TextBlock x:Name="ToolText" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Models -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Click="OnAddFolder" Margin="0,0,6,0" ToolTip="Add a folder to search for containers">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8F4;" Margin="0,0,6,0"/>
                                    <TextBlock Text="Add folder"/>
                                </StackPanel>
                            </Button>
                            <Button Click="OnAddContainer" Margin="0,0,6,0" ToolTip="Add one container folder">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,6,0"/>
                                    <TextBlock Text="Add model"/>
                                </StackPanel>
                            </Button>
                            <Button Click="OnRescan" ToolTip="Look for models again">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;"/>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="Models to load" Style="{StaticResource SectionTitle}" Margin="0"/>
                    </DockPanel>
                    <TextBlock x:Name="FoldersText" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                    <StackPanel x:Name="ModelRows"/>
                    <TextBlock x:Name="SelectionText" Margin="0,10,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- Memory -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Memory and device" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="GpuRadio" Content="Use the GPU when there is one" GroupName="Device" Checked="OnSettingChanged" Margin="0,0,24,0"/>
                        <RadioButton x:Name="CpuRadio" Content="CPU only" GroupName="Device" Checked="OnSettingChanged"/>
                    </StackPanel>

                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" x:Name="RamValueText" FontWeight="SemiBold" Width="110" TextAlignment="Right"
                                   VerticalAlignment="Center"/>
                        <CheckBox x:Name="RamLimitCheck" Content="Limit system memory (RAM)" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </DockPanel>
                    <Slider x:Name="RamSlider" Minimum="2" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                            ValueChanged="OnSliderChanged" IsEnabled="{Binding IsChecked, ElementName=RamLimitCheck}"/>
                    <TextBlock x:Name="RamHelp" Style="{StaticResource Caption}" Margin="0,2,0,14"/>

                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" x:Name="GpuValueText" FontWeight="SemiBold" Width="110" TextAlignment="Right"
                                   VerticalAlignment="Center"/>
                        <CheckBox x:Name="GpuLimitCheck" Content="Limit GPU memory" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </DockPanel>
                    <Slider x:Name="GpuSlider" Minimum="0" Maximum="24" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                            ValueChanged="OnSliderChanged" IsEnabled="{Binding IsChecked, ElementName=GpuLimitCheck}"/>
                    <TextBlock x:Name="GpuHelp" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Advanced -->
            <Expander x:Name="AdvancedExpander" Header="Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Margin="0,10,0,0">
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.ColumnSpan="2" Text="Network" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Grid.Row="1" Text="Port" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="PortBox" Width="100" HorizontalAlignment="Left" TextChanged="OnSettingChanged" Margin="0,2"/>
                            <CheckBox Grid.Row="2" Grid.Column="1" x:Name="NetworkCheck" Content="Accept connections from other computers (listen on 0.0.0.0)"
                                      Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                            <TextBlock Grid.Row="3" Text="API key" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="ApiKeyBox" PasswordChanged="OnSettingChanged" Margin="0,2"
                                         ToolTip="Clients must send this as a Bearer token. Leave empty for no authentication."/>
                            <CheckBox Grid.Row="4" Grid.Column="1" x:Name="StopOnExitCheck" Content="Stop the server when AMQL Studio closes"
                                      Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.ColumnSpan="2" Text="Defaults for chat requests" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Caption}" Margin="0,0,0,8"
                                       Text="Used when a request leaves them out. A model's own options (⚙ beside it) win over these. Leave a box empty for the server's default."/>
                            <CheckBox Grid.Row="2" Grid.Column="1" x:Name="ThinkCheck" Content="Think before answering (reasoning)"
                                      Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                            <TextBlock Grid.Row="3" Text="Max reply tokens" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="MaxTokensBox" Width="100" HorizontalAlignment="Left" TextChanged="OnSettingChanged" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Text="Temperature" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="TemperatureBox" Width="100" HorizontalAlignment="Left" TextChanged="OnSettingChanged" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Text="Top-p" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" x:Name="TopPBox" Width="100" HorizontalAlignment="Left" TextChanged="OnSettingChanged" Margin="0,2"/>
                            <TextBlock Grid.Row="6" Text="Top-k" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="6" Grid.Column="1" x:Name="TopKBox" Width="100" HorizontalAlignment="Left" TextChanged="OnSettingChanged" Margin="0,2"/>
                            <TextBlock Grid.Row="7" Text="GPU weight format" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Row="7" Grid.Column="1" x:Name="GpuFormatBox" SelectionChanged="OnSettingChanged" MinWidth="220"
                                      HorizontalAlignment="Left" Margin="0,2"
                                      ToolTip="NVFP4/MXFP4 serve each container's GPTQ-rounded 4-bit copy, built beside it the first time">
                                <ComboBoxItem Content="As stored" Tag=""/>
                                <ComboBoxItem Content="FP16" Tag="fp16"/>
                                <ComboBoxItem Content="NVFP4 (4-bit, GPTQ copy)" Tag="nvfp4"/>
                                <ComboBoxItem Content="MXFP4 (4-bit, GPTQ copy)" Tag="mxfp4"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Serving behaviour" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                       Text="Each of these turns off something the server does by default."/>
                            <WrapPanel x:Name="BehaviourPanel" Orientation="Horizontal"/>
                            <TextBlock Text="N-gram packs (one file per line)" Margin="0,12,0,4"/>
                            <TextBox x:Name="NGramBox" AcceptsReturn="True" MinHeight="44" TextWrapping="NoWrap" TextChanged="OnSettingChanged"
                                     VerticalContentAlignment="Top"/>
                            <TextBlock Text="Extra arguments" Margin="0,12,0,4"/>
                            <TextBox x:Name="ExtraArgsBox" TextChanged="OnSettingChanged" FontFamily="{StaticResource MonoFont}"
                                     ToolTip="Passed to amql-server as typed, after everything else (e.g. --ngram-lambda 0.3)"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Command line" Style="{StaticResource SectionTitle}"/>
                            <TextBox x:Name="CommandLineText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="11.5"/>
                            <DockPanel Margin="0,14,0,6">
                                <Button DockPanel.Dock="Right" Content="Copy" Click="OnCopyConsole" Padding="10,2"/>
                                <TextBlock Text="Server output" Style="{StaticResource SectionTitle}" Margin="0"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                                       Text="The server's own messages, kept for diagnosing a start that fails. The Monitor shows what it is doing."/>
                            <TextBox x:Name="ConsoleBox" Style="{StaticResource OutputBox}" Height="220"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
