<UserControl x:Class="Amql.Gui.Pages.PlaygroundPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,22,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="Model" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ModelBox" MinWidth="220" SelectionChanged="OnModelChanged"/>
                <Button Click="OnRefreshModels" Margin="6,0,0,0" ToolTip="Ask the server for its models again">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;"/>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Playground" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Talk to a chat model on the running server, or send any request to its API."/>
            </StackPanel>
        </DockPanel>

        <!-- Shown when there is no server to talk to -->
        <Border Grid.Row="1" x:Name="NoServerBanner" Style="{StaticResource Card}" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Go to Server" Click="OnGoToServer" Style="{DynamicResource AccentButtonStyle}"/>
                <TextBlock x:Name="NoServerText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="The server isn't running. Choose models and start it on the Server page."/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="2" x:Name="Tabs">
            <TabItem Header="Chat">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,10">
                        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="16,12">
                            <StackPanel x:Name="Conversation"/>
                        </ScrollViewer>
                    </Border>

                    <DockPanel Grid.Row="1" Margin="0,0,12,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Vertical" Margin="8,0,0,0">
                            <Button x:Name="SendButton" Click="OnSend" Style="{DynamicResource AccentButtonStyle}" MinWidth="90" Padding="14,8"
                                    ToolTip="Send (Enter). Shift+Enter starts a new line.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" Margin="0,0,8,0"/>
                                    <TextBlock Text="Send"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopButton" Content="Stop" Click="OnStop" Margin="0,6,0,0" IsEnabled="False"/>
                        </StackPanel>
                        <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="200"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" PreviewKeyDown="OnInputKeyDown"/>
                    </DockPanel>

                    <StackPanel Grid.Column="1" Grid.RowSpan="2">
                        <TextBlock Text="Settings" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="ThinkCheck" Content="Think before answering" Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>
                        <CheckBox x:Name="ShowThinkingCheck" Content="Show the thinking" IsChecked="True" Margin="0,4,0,0"/>
                        <TextBlock Text="System prompt" Margin="0,12,0,4"/>
                        <TextBox x:Name="SystemBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="180"
                                 VerticalContentAlignment="Top" TextChanged="OnOptionChanged" VerticalScrollBarVisibility="Auto"/>
                        <Expander Header="Advanced" Margin="0,12,0,0">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Temperature" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1" x:Name="TemperatureBox" TextChanged="OnOptionChanged" Margin="0,2"
                                         ToolTip="Empty uses the server's default"/>
                                <TextBlock Grid.Row="1" Text="Max tokens" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="MaxTokensBox" TextChanged="OnOptionChanged" Margin="0,2"
                                         ToolTip="Empty uses the server's default"/>
                                <CheckBox Grid.Row="2" Grid.ColumnSpan="2" x:Name="ShowRequestCheck" Content="Show each request's JSON"/>
                            </Grid>
                        </Expander>
                        <Button Content="New conversation" Click="OnClear" Margin="0,16,0,0" HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="LastStatsText" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="API request">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Click="OnSendApi" Style="{DynamicResource AccentButtonStyle}" Content="Send" MinWidth="80"/>
                            <ComboBox x:Name="EndpointBox" SelectionChanged="OnEndpointChanged" Margin="0,0,8,0">
                                <ComboBoxItem Content="POST /v1/chat/completions" Tag="/v1/chat/completions"/>
                                <ComboBoxItem Content="POST /v1/responses" Tag="/v1/responses"/>
                                <ComboBoxItem Content="POST /v1/embeddings" Tag="/v1/embeddings"/>
                                <ComboBoxItem Content="POST /v1/classify" Tag="/v1/classify"/>
                                <ComboBoxItem Content="POST /v1/decisions" Tag="/v1/decisions"/>
                            </ComboBox>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,6"
                                   Text="Request body (JSON). Choosing an endpoint fills in an example for the selected model."/>
                        <TextBox x:Name="ApiBodyBox" AcceptsReturn="True" AcceptsTab="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="Response" FontWeight="SemiBold" Margin="0,6,0,10"/>
                        <TextBox x:Name="ApiResponseBox" Style="{StaticResource OutputBox}"/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
