<Window x:Class="Amql.Gui.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About AMQL Studio" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="28,24,28,20">
        <TextBlock Text="AMQL Studio" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,2,0,16"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Local inference and model tools: serve containers behind an OpenAI-compatible endpoint, watch what the server is doing, chat with models, and run every amql-cli command from a form."/>
        <TextBlock Text="Copyright © 2026 Simon Soanes" FontWeight="SemiBold"/>
        <TextBlock Margin="0,4,0,0">
            <Hyperlink x:Name="ProjectLink" NavigateUri="https://github.com/simonsoanes/AMQL" RequestNavigate="OnNavigate">
                <Run Text="https://github.com/simonsoanes/AMQL"/>
            </Hyperlink>
        </TextBlock>
        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="Released under the MIT License."/>
        <Button Content="Close" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" MinWidth="90"
                Margin="0,20,0,0" Click="OnClose"/>
    </StackPanel>
</Window>
