<Window x:Class="Amql.Gui.Dialogs.CliSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CLI Settings" Height="360" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="CLI exe path" Style="{StaticResource FieldLabel}"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="ExeBox" ToolTip="A built amql-cli.exe; wins over the repo path when set"/>
        <Button Grid.Row="0" Grid.Column="2" Content="…" Padding="8,3" Click="OnBrowseExe"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="AMQL repo path" Style="{StaticResource FieldLabel}"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="RepoBox" ToolTip="Runs the CLI via 'dotnet run --project src/Amql.Cli'"/>
        <Button Grid.Row="1" Grid.Column="2" Content="…" Padding="8,3" Click="OnBrowseRepo"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Device" Style="{StaticResource FieldLabel}"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DeviceBox">
            <ComboBoxItem Content="auto"/>
            <ComboBoxItem Content="cpu"/>
            <ComboBoxItem Content="gpu"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="AMQL_WEIGHTS" Style="{StaticResource FieldLabel}"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="WeightsBox" ToolTip="e.g. mxfp4 — empty leaves the environment variable unset"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" TextWrapping="Wrap" Foreground="Gray" Margin="2,12,2,0"
                   Text="With both paths empty the GUI tries 'amql-cli' on PATH. 'auto' lets the CLI probe for CUDA; 'cpu'/'gpu' pass the CLI's --cpu/--global flag. All settings are stored in the .amqlproj file."/>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="100" IsDefault="True" Click="OnOk"/>
            <Button Content="Cancel" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
