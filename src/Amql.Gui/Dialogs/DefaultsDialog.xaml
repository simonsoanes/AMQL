<Window x:Class="Amql.Gui.Dialogs.DefaultsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Defaults" Height="330" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Container dir" Style="{StaticResource FieldLabel}"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="ContainerBox"/>
        <Button Grid.Row="0" Grid.Column="2" Content="…" Padding="8,3" Click="OnBrowseContainer"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tokenizer dir" Style="{StaticResource FieldLabel}"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TokenizerBox"/>
        <Button Grid.Row="1" Grid.Column="2" Content="…" Padding="8,3" Click="OnBrowseTokenizer"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Patch file" Style="{StaticResource FieldLabel}"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="PatchBox"/>
        <Button Grid.Row="2" Grid.Column="2" Content="…" Padding="8,3" Click="OnBrowsePatch"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Component" Style="{StaticResource FieldLabel}"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="ComponentBox"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" TextWrapping="Wrap" Foreground="Gray" Margin="2,12,2,0"
                   Text="These are stamped into any command form with 'Apply Project Defaults' — they never override a value you type manually."/>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="100" IsDefault="True" Click="OnOk"/>
            <Button Content="Cancel" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
