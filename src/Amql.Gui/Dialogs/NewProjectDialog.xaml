<Window x:Class="Amql.Gui.Dialogs.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New AMQL Project" SizeToContent="Height" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Project name" Style="{StaticResource FieldLabel}" Margin="0,6,12,6"/>
        <TextBox Margin="0,3" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NameBox" Text="My AMQL Project"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Project file" Style="{StaticResource FieldLabel}" Margin="0,6,12,6"/>
        <TextBox Margin="0,3" Grid.Row="1" Grid.Column="1" x:Name="PathBox"/>
        <Button Grid.Row="1" Grid.Column="2" Content="…" Click="OnBrowsePath" Margin="6,3,0,3"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Container dir" Style="{StaticResource FieldLabel}" Margin="0,6,12,6"
                   ToolTip="Default VINDEX3 container directory (encode output)"/>
        <TextBox Margin="0,3" Grid.Row="2" Grid.Column="1" x:Name="ContainerBox"/>
        <Button Grid.Row="2" Grid.Column="2" Content="…" Click="OnBrowseContainer" Margin="6,3,0,3"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Tokenizer dir" Style="{StaticResource FieldLabel}" Margin="0,6,12,6"
                   ToolTip="Default HF checkpoint directory containing tokenizer.json"/>
        <TextBox Margin="0,3" Grid.Row="3" Grid.Column="1" x:Name="TokenizerBox"/>
        <Button Grid.Row="3" Grid.Column="2" Content="…" Click="OnBrowseTokenizer" Margin="6,3,0,3"/>

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Create" Width="100" IsDefault="True" Click="OnCreate" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="Cancel" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
