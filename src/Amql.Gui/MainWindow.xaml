<Window x:Class="Amql.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:explorer="clr-namespace:Amql.Gui.Explorer"
        Title="AMQL Studio" Height="760" Width="1240"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Project">
                <MenuItem Header="_New Project…" Click="OnNewProject"/>
                <MenuItem Header="_Open Project…" Click="OnOpenProject"/>
                <MenuItem Header="_Save Project" Click="OnSaveProject" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save Project _As…" Click="OnSaveProjectAs"/>
                <Separator/>
                <MenuItem Header="Project _Defaults…" Click="OnProjectDefaults"/>
                <MenuItem Header="_CLI Settings…" Click="OnCliSettings"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="_Run">
                <MenuItem Header="_Run Command" Click="OnRun" InputGestureText="F5"/>
                <MenuItem Header="_Cancel Run" Click="OnCancelRun"/>
                <MenuItem Header="Clear _Output" Click="OnClearOutput"/>
            </MenuItem>
            <MenuItem Header="_Explorer">
                <MenuItem Header="_Open Container in Explorer…" Click="OnOpenExplorer"/>
                <MenuItem Header="_Close Explorer Container" Click="OnCloseExplorer"/>
                <Separator/>
                <MenuItem Header="_Run and Display Inference…" Click="OnRunAndDisplayInference"
                          ToolTip="Run a prompt through the container open in the Explorer and watch the visualiser fill in live"/>
                <MenuItem Header="_Inference Visualiser…" Click="OnOpenVisualiser"
                          ToolTip="Open a captured operator trace (--trace-json) and see which tensors carried a given prompt"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About AMQL Studio" Click="OnAbout"/>
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="No project loaded"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="DeviceText" Text="device: auto" Margin="8,0"/>
                    <TextBlock x:Name="CliText" Text="cli: (unset)" Margin="8,0"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Tab control for commands vs explorer -->
        <TabControl>
            <TabItem Header="Commands">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" MinWidth="180"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="3*" MinWidth="380"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="2*" MinWidth="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- Command list -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Commands" FontWeight="Bold" Margin="6,6,6,2"/>
                        <TreeView x:Name="CommandTree" SelectedItemChanged="OnCommandSelected"/>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#FFE0E0E0"/>

                    <!-- Parameter form + output -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*" MinHeight="140"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>

                        <!-- Command header + run bar -->
                        <Border Grid.Row="0" Padding="8" Background="#FFF4F6FA" BorderBrush="#FFD0D7E2" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock x:Name="CommandTitle" Text="Select a command" FontSize="16" FontWeight="Bold"/>
                                <TextBlock x:Name="CommandSummary" Text="" TextWrapping="Wrap" Foreground="Gray" Margin="0,2,0,6"/>
                                <TextBlock x:Name="CommandLinePreview" Text="" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                           TextWrapping="Wrap" Foreground="#FF3A5A8A" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="RunButton" Content="▶ Run (F5)" Click="OnRun" FontWeight="Bold" Padding="18,6"/>
                                    <Button x:Name="CancelButton" Content="■ Cancel" Click="OnCancelRun" IsEnabled="False" Padding="14,6"/>
                                    <Button Content="Apply Project Defaults" Click="OnApplyDefaults" Padding="14,6"
                                            ToolTip="Stamp the project-wide container/tokenizer/patch/component into this form"/>
                                    <ProgressBar x:Name="RunProgress" Width="220" Height="18" Margin="12,0" Minimum="0" Maximum="100"/>
                                    <TextBlock x:Name="RunStateText" VerticalAlignment="Center" Text="idle"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Dynamic parameter form -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ParamPanel" Margin="8"/>
                        </ScrollViewer>

                        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="#FFE0E0E0"/>

                        <!-- Output -->
                        <DockPanel Grid.Row="3">
                            <TextBlock DockPanel.Dock="Top" Text="Output" FontWeight="Bold" Margin="2,4"/>
                            <TextBox x:Name="OutputBox" Style="{StaticResource OutputBox}"/>
                        </DockPanel>
                    </Grid>

                    <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="#FFE0E0E0"/>

                    <!-- Run history -->
                    <DockPanel Grid.Column="4">
                        <Grid DockPanel.Dock="Top" Margin="6,6,6,2">
                            <TextBlock Text="Run History (saved in the project)" FontWeight="Bold"/>
                            <Button Content="Clear" HorizontalAlignment="Right" Padding="8,2" Click="OnClearHistory"/>
                        </Grid>
                        <ListBox x:Name="HistoryList" SelectionChanged="OnHistorySelected"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Explorer">
                <explorer:ContainerExplorer x:Name="ExplorerControl"
                    TensorSelected="OnTensorSelected"
                    RunInferenceRequested="OnExplorerRunInference"/>
            </TabItem>
        </TabControl>
    </DockPanel>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="OnSaveProject"/>
    </Window.CommandBindings>
</Window>
