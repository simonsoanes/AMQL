<Window x:Class="Amql.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AMQL Studio" Height="820" Width="1320" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Border Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,18,12,14">
                    <TextBlock Text="AMQL Studio" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Local inference and model tools" Style="{StaticResource Caption}"/>
                </StackPanel>

                <!-- About, at the very bottom -->
                <Button DockPanel.Dock="Bottom" Click="OnAbout" HorizontalAlignment="Left" Margin="10,0,10,10"
                        Background="Transparent" BorderThickness="0" Padding="8,4" ToolTip="Version, copyright and project link">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,8,0"/>
                        <TextBlock Text="About AMQL Studio" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </Button>

                <!-- Server status, always in view -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="10,10,10,4" Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ServerDot" Width="10" Height="10" Fill="{StaticResource IdleBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Server" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="ServerDetailText" Text="Not running" Style="{StaticResource Caption}" Margin="0,4,0,8"
                                   TextTrimming="CharacterEllipsis"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ServerToggleButton" Grid.Column="0" Content="Start" HorizontalAlignment="Stretch" Padding="6,5"
                                    Click="OnToggleServer"/>
                            <Button Grid.Column="2" HorizontalAlignment="Stretch" Click="OnOpenMonitor" Padding="6,5"
                                    ToolTip="Open a live view of what the server is doing">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Margin="0,0,4,0"/>
                                    <TextBlock Text="Monitor"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <ListBox x:Name="NavList" SelectionChanged="OnNavigate" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </Border>

        <!-- Page host -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Focusable="False"/>
    </Grid>
</Window>
