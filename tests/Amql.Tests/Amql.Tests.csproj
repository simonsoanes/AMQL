<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Amql.Safetensors\Amql.Safetensors.csproj" />
    <ProjectReference Include="..\..\src\Amql.Gguf\Amql.Gguf.csproj" />
    <ProjectReference Include="..\..\src\Amql.Vindex3\Amql.Vindex3.csproj" />
    <ProjectReference Include="..\..\src\Amql.Inference\Amql.Inference.csproj" />
    <ProjectReference Include="..\..\src\Amql.Entail\Amql.Entail.csproj" />
    <ProjectReference Include="..\..\src\Amql.Hf\Amql.Hf.csproj" />
    <ProjectReference Include="..\..\src\Amql.Cli\Amql.Cli.csproj" />
    <ProjectReference Include="..\..\src\Amql.Server\Amql.Server.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="golden_tokenizer.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="synth_oracle.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="golden_qwen35_forward.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="golden_qwen35_1tok.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="golden_lfm3_synth.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="golden_a2d_qwen3_synth.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="golden_a2d_qwen3_sample.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fixtures\golden_mdlm_real.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="torch_state_dict.pt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="torch_noncontiguous.pt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fixtures\von-tiny\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fixtures\qwen-cls-tiny\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fixtures\gated_delta_golden.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fixtures\qwen-lm-tiny\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fixtures\arch-zoo\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="fixtures\qwen35_chat_template.jinja" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The locally built CUDA backend (native/amql_cuda, gitignored), so the
       "gpu" collection runs on the device where one is present instead of
       skipping. Absent on CPU-only machines; those tests then fall back. -->
  <ItemGroup Condition="Exists('..\..\native\amql_cuda\bin\amql_cuda.dll')">
    <None Include="..\..\native\amql_cuda\bin\amql_cuda.dll" Link="amql_cuda.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>